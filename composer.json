{
  "name": "shugoi/shugoi-php",
  "description": "Shugoi anti-abuse protection — PHP/Laravel middleware",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.0",
    "psr/http-server-middleware": "^1.0",
    "psr/http-message": "^2.0",
    "nyholm/psr7": "^1.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "orchestra/testbench": "^10.0",
    "mockery/mockery": "^1.6"
  },
  "homepage": "https://shugoi.com",
  "support": {
    "issues": "https://github.com/ShugoiTeam/shugoi-php/issues",
    "source": "https://github.com/ShugoiTeam/shugoi-php"
  },
  "suggest": {
    "nyholm/psr7": "Required for Laravel integration (PSR-7 HTTP message implementation)"
  },
  "autoload": {
    "psr-4": {
      "Shugoi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Shugoi\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "lint": "find src tests -type f -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Shugoi\\Laravel\\ShugoiServiceProvider"
      ],
      "aliases": {
        "Shugoi": "Shugoi\\Laravel\\ShugoiFacade"
      }
    }
  }
}
