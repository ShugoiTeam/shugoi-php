{
  "name": "shugoi/websocket-test-site",
  "description": "Standalone Laravel site for testing the Shugoi PHP WebSocket transport",
  "type": "project",
  "require": {
    "php": "~8.2.35-stable || ~8.3.36-stable || ~8.4.27-stable || ^8.5.12-stable",
    "laravel/framework": "^12.0",
    "shugoi/shugoi-php": "0.5.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../..",
      "options": {
        "symlink": false,
        "versions": {
          "shugoi/shugoi-php": "0.5.0"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
