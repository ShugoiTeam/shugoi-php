APP_NAME="Shugoi WebSocket Lab"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ws-demo.example.com
LOG_CHANNEL=stack
LOG_LEVEL=info

SHUGOI_SITE_KEY=REPLACE_WITH_TEST_SITE_KEY
SHUGOI_SECRET=REPLACE_WITH_TEST_SITE_SECRET
SHUGOI_SIGNING_SECRET=
SHUGOI_BASE_URL=https://api.shugoi.com/api/v1
SHUGOI_BROWSER_TRANSPORT=websocket
SHUGOI_RENDER_STORE=disk
SHUGOI_RENDER_STORE_PATH=/var/lib/shugoi-websocket-demo/render
SHUGOI_PUBLIC_ORIGIN=https://ws-demo.example.com
SHUGOI_RENDER_WS_BIND=127.0.0.1
SHUGOI_RENDER_WS_PORT=8787

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
